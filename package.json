{
  "name": "sprout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:rules && tsc && vite build",
    "build:rules": "tsc -p tsconfig.eslint-rules.json",
    "lint": "npm run lint:js ; npm run lint:scss",
    "lint:js": "eslint",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:fix": "npm run lint:js -- --fix ; npm run lint:scss -- --fix",
    "postpack": "find src eslint-rules -name \"*.js\" -type f -delete",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@onefinity/eslint-config": "^4.1.0",
    "@onefinity/stylelint-config": "^3.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "10.8.1"
    }
  }
}
