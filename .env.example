# ── Sprout — environment variables ──────────────────────────────────────────────
# Copy to .env.local and fill in the blanks:
#     cp .env.example .env.local
# The Docker Compose app service reads these (via compose), Next also reads
# .env.local for local `bun run dev`. Never commit real values.

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev Postgres, started by `bun run db:up` (docker compose).
DATABASE_URL=postgres://sprout:sprout@localhost:5432/sprout

# ── Better Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Used to sign auth session cookies. Keep secret; rotating it signs everyone out.
BETTER_AUTH_SECRET=

# Base URL of the app. Must match where you run it in dev.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ────────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PlantNet (optional) ─────────────────────────────────────────────────────────
# A shared API key (https://my.plantnet.org) used server-side for species
# identification. If empty, each user supplies their own key in Settings,
# stored in their browser's localStorage.
PLANTNET_API_KEY=
